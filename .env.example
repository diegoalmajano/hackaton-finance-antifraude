# =====================================================================
#  Asistente antifraude — variables de entorno (EJEMPLO, sin secretos)
# =====================================================================
# Este archivo es solo una referencia: el asistente NO lo lee.
# Las variables se definen en la consola antes de arrancar (ver
# docs/CONFIGURACION.md). Nunca escriba aquí claves reales ni suba un
# archivo .env al repositorio (.gitignore lo excluye).
#
# Todas son opcionales. Si no se definen, se usan los valores indicados.

# Puerto local del asistente. Solo escucha en 127.0.0.1 (no configurable).
# Entero entre 1024 y 65535. Por defecto: 8790.
APP_PORT=8790

# Nivel de detalle de los registros: DEBUG, INFO, WARNING o ERROR.
# Por defecto: INFO. Los registros nunca incluyen códigos, cookies, tokens,
# claves ni contenido de mensajes.
APP_LOG_LEVEL=INFO

# Clave de la API de Anthropic (opcional; solo con presupuesto aprobado).
# Déjela vacía. Sin clave, el análisis con IA figurará como «no configurado».
# SECRETO: no la escriba en archivos del repositorio ni la comparta.
ANTHROPIC_API_KEY=

# Modo demostración: 1 = carga la entidad ficticia «Banco Ficticio» y los
# ejemplos sintéticos de la demo (siempre etiquetados como EJEMPLO SINTÉTICO).
# Por defecto: 0 (desactivado).
APP_DEMO_MODE=0

# Modelo de Claude para el análisis profundo (opcional; requiere además la
# librería oficial «anthropic», cuya instalación está pendiente de autorización).
# Vacío a propósito: la elección entre Opus y Sonnet está PENDIENTE
# de una prueba comparativa (decisiones D-24 y D-32).
CLAUDE_MODEL=

# --- Control de gasto de la IA (docs/CONTROL_COSTES_IA.md). TODO cerrado por defecto. ---
# 1 = permite usar la IA (además hacen falta clave, modelo, presupuesto y el SDK). Por defecto 0.
AI_ENABLED=0
# Opus 5.5 solo con permiso expreso (1). Por defecto 0: bloqueado. Modelo previsto para pruebas: claude-sonnet-5-5.
AI_ALLOW_OPUS=0
# Presupuesto AUTORIZADO en USD (tope local preventivo, máx. 10). Por defecto 0 = sin gasto.
# El previsto para las primeras pruebas es 0.50, pero NO está autorizado hasta que lo apruebe el usuario.
AI_BUDGET_USD=0
# Límites por solicitud y por sesión.
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_REQUESTS=20
# Razonamiento: adaptive (recomendado, con esfuerzo low) u off (solo Sonnet 5.5). Esfuerzo: low|medium|high.
AI_THINKING=adaptive
AI_EFFORT=low
# Libro de gasto (vacío = %LOCALAPPDATA%\antifraude\gasto_ia.json). Siempre FUERA del repositorio.
AI_LEDGER_PATH=

# Gmail: permanece apagado; requiere instalación/OAuth y consentimiento específicos.
APP_GMAIL_ENABLED=0
# Cliente OAuth fuera del repositorio; vacío mientras no se autorice Gmail real.
APP_GMAIL_CLIENT_SECRET=
